# Frontend build-time configuration. Copy to .env.local to override locally.

# Backend origin, without a trailing slash.
#   unset  -> http://localhost:8000 (local development backend)
#   empty  -> same origin as the page (frontend and backend behind one reverse proxy)
# VITE_API_BASE_URL=https://api.example.com

# Vite dev-server port. Keep it in step with the backend's ALLOWED_ORIGINS;
# start.sh passes the same FRONTEND_PORT to both sides.
# FRONTEND_PORT=5173
