  "kinds": [
    {
      "ends": [
        "丹",
        "丸",
        "丹药",
        "灵丹"
      ],
      "always": true,
      "look": "丹药是一粒圆润的丹丸，表面一圈圈丹纹清晰可见，按药性一种主色、带柔和光泽；丹身周围萦绕一缕淡淡的丹香薄雾"
    },
    {
      "ends": [
        "飞剑"
      ],
      "always": true,
      "look": "飞剑剑身修长，刃口一线寒光，剑脊铭刻符纹，剑柄无护手或护手极小；悬空时剑尖朝前，剑身微微嗡鸣发光"
    },
