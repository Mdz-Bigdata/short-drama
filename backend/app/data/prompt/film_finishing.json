      "dim": 0.45,
      "blur_radius": 6,
      "end_margin_seconds": 0.1
    },
    "zoom": {
      "_doc": "缓慢推近：整张卡时长内放大 amount(0.08 = 8%)；先放大 oversample 倍再推，避免逐帧取整的抖动。",
