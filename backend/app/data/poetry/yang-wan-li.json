    {
      "id": "su-xin-shi-xu-gong-dian",
      "title": "宿新市徐公店",
      "form": "诗",
      "tune": "",
      "preface": "",
      "text": "篱落疏疏一径深，树头花落未成阴。\n儿童急走追黄蝶，飞入菜花无处寻。",
      "themes": [
        "童趣",
        "春",
        "田园",
        "乡村",
        "儿童"
      ],
      "emotions": [
        "活泼",
        "恬淡"
      ],
      "famous_lines": [
        "儿童急走追黄蝶，飞入菜花无处寻"
      ],
      "drama_uses": [
