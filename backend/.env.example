# AI short-drama server configuration. Never commit real secrets.

# Seedance / Volcengine Ark
SEEDANCE_API_KEY=YOUR_SEEDANCE_API_KEY
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_NAME=YOUR_SEEDANCE_VIDEO_MODEL
SEEDANCE_IMAGE_MODEL_NAME=YOUR_SEEDREAM_IMAGE_MODEL
SEEDANCE_IMAGE_SIZE=1440x2560
CHARACTER_SHEET_SIZE=2560x1440
SEEDANCE_PROMPT_OPT=1

# Text and image providers
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-turbo
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL_NAME=YOUR_GEMINI_MODEL
AGNES_API_KEY=YOUR_AGNES_API_KEY
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_NAME=agnes-2.0-flash

# MiniMax H3 video plus Speech/Music generation (server only)
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY
MINIMAX_BASE_URL=https://api.minimaxi.com
# Optional. When omitted, H3 uses /v2/video_generation on the MINIMAX_BASE_URL host.
MINIMAX_H3_ENDPOINT=https://api.minimaxi.com/v2/video_generation
# H3 v2 returns the final URL from task.content.url. The v1 file endpoint remains
# available only as a compatibility fallback for older task responses.
# MINIMAX_H3_STATUS_URL_TEMPLATE=https://api.minimaxi.com/v2/query/video_generation/{task_id}
# MINIMAX_FILES_URL=https://api.minimaxi.com/v1/files/retrieve

# ElevenLabs TTS, dialogue, SFX, music, STT and dubbing (server only)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
# API root is recommended. A complete /v1/sound-generation endpoint is also
# accepted and normalized to the same root for TTS/dialogue/music/STT routes.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_FEMALE_ID=YOUR_ELEVENLABS_FEMALE_VOICE_ID
ELEVENLABS_VOICE_MALE_ID=YOUR_ELEVENLABS_MALE_VOICE_ID
# Optional stable per-character casting, JSON object: {"角色名":"voice_id"}
ELEVENLABS_VOICE_MAP={}

# Where the bundled skills live (every production guide is inside a skill and listed in its manifest.json).
# Defaults to backend/skills; set it only when a deployment ships the skills elsewhere.
# SKILLS_DIR=/absolute/path/to/skills

# Local Seedance 2.5 primary optimizer; defaults to ~/.agents/skills/sd25-pe, then the bundled copy.
# SD25_PE_SKILL_PATH=/absolute/path/to/sd25-pe
# Optional upstream checkout or Skill directory for five-part guidance; the bundled clean-room Skill is the fallback.
# SD25_FIVE_PART_SKILL_PATH=/absolute/path/to/sd-2-5-prompt

# Optional network proxy for every provider
# SEEDANCE_PROXY=http://127.0.0.1:7890
# Proxy for Volcengine Ark hosts only; takes precedence over the one above for Ark.
# ARK_PROXY=http://127.0.0.1:7890
# Seedance clip resolution (default 720p; the final cut is conformed to 1080x1920).
# SEEDANCE_VIDEO_RESOLUTION=720p

# Alibaba Cloud SMS
# ALIBABA_CLOUD_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ALIBABA_CLOUD_ACCESS_KEY_ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ALIBABA_CLOUD_ACCESS_KEY_SECRET
ALIBABA_CLOUD_SMS_SIGN_NAME=YOUR_SMS_SIGN_NAME
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=YOUR_SMS_TEMPLATE_CODE

# Authentication. AUTH_SIGNING_SECRET must be random and at least 32 characters.
AUTH_SIGNING_SECRET=YOUR_RANDOM_32_PLUS_CHARACTER_SESSION_SECRET
AUTH_SESSION_TTL_SECONDS=86400
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_COOLDOWN_SECONDS=60
COOKIE_SECURE=0
# Origins allowed to send the login cookie and state-changing requests. When omitted it
# is derived from FRONTEND_PORT: http://localhost:<port> and http://127.0.0.1:<port>.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development only. Never enable either flag in production.
AUTH_MOCK_CODES=0
AUTH_EXPOSE_MOCK_CODE=0

# Server address. start.sh and `python main.py` read the same values; start.sh also
# points the frontend at BACKEND_PORT unless VITE_API_BASE_URL is set.
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# Auto-reload on source changes. Defaults to 1 in development and 0 in production.
# BACKEND_RELOAD=1
# Address browsers use to reach this backend. Defaults to http://localhost:<BACKEND_PORT>.
# PUBLIC_BASE_URL=https://drama.example.com
# Public prefix of generated media. Defaults to <PUBLIC_BASE_URL>/media; may point at a CDN.
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media
# Prefix of the promotional short links produced by the PR stage.
# SHARE_LINK_BASE_URL=https://short-drama.volces.com/s

# PostgreSQL product platform (users, capabilities, elements, membership, billing).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/short-drama
# Encrypts provider API keys saved through the global model configuration center.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production requires this value from a deployment secret manager. Development creates
# a gitignored mode-0600 backend/runtime/model-config.key when it is omitted.
# MODEL_CONFIG_MASTER_KEY=YOUR_FERNET_MASTER_KEY
# Local development administrator. These public defaults are rejected in production.
BOOTSTRAP_ADMIN=1
BOOTSTRAP_ADMIN_LOGIN=admin@short-drama
BOOTSTRAP_ADMIN_PASSWORD=admin@123

# HMAC secret for idempotent WeChat/Alipay webhook envelopes (32+ characters).
PAYMENT_WEBHOOK_SECRET=YOUR_RANDOM_32_PLUS_CHARACTER_WEBHOOK_SECRET

# Local tooling. Each is found automatically on macOS and common Linux layouts;
# set a path only when it lives somewhere else.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Font for burned-in subtitles and the title card (a CJK .ttc/.ttf/.otf).
# SUBTITLE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Voice of the local macOS `say` fallback.
# LOCAL_TTS_VOICE=Tingting
# Second line of the title card; set it empty to leave the card with the title only.
# TITLE_CARD_TAGLINE=AI 短剧 · 一键成片

# What one episode must be at the least: shots, total seconds, and the advised ceiling.
# A drafted episode below the first two is sent back to the model; above the third it is only flagged.
# SCREENWRITING_EPISODE_MIN_SCENES=2
# SCREENWRITING_EPISODE_MIN_SECONDS=60
# SCREENWRITING_EPISODE_MAX_SECONDS=360

# Reference prices per model, for usage records and batch estimates (see backend/app/data/model_pricing.example.json).
# MODEL_PRICING_PATH=/absolute/path/to/model_pricing.json

# Per-episode production pacing.
# SHOTS_PER_EPISODE=16
# REANCHOR_EVERY=4
# SHOT_DURATION=10

# Optional local persistence paths (production should use an external durable store).
# USERS_DB_PATH=/absolute/path/to/users_db.json
# TASKS_DB_PATH=/absolute/path/to/tasks_db.json
# STUDIO_DB_PATH=/absolute/path/to/studio.sqlite3

# Kling / xAI Grok Imagine / HappyHorse (fal.ai) / LTX video adapters (server only).
# Prefer the model configuration center; these environment values are the fallback.
# Kling needs both keys, colon separated; the backend signs the official HS256 JWT per request.
KLING_API_KEY=YOUR_KLING_ACCESS_KEY:YOUR_KLING_SECRET_KEY
KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_MODEL_NAME=kling-v2-1
# KLING_MODE=std
XAI_API_KEY=YOUR_XAI_API_KEY
XAI_BASE_URL=https://api.x.ai
FAL_KEY=YOUR_FAL_KEY
FAL_QUEUE_URL=https://queue.fal.run
LTX_API_KEY=YOUR_LTX_API_KEY
LTX_BASE_URL=https://api.ltx.io
# VIDEO_ASPECT_RATIO=9:16
# VIDEO_RESOLUTION=1080p
# VIDEO_ADAPTER_WAIT_SECONDS=900
# VIDEO_ADAPTER_POLL_SECONDS=5

# Generation queue (stage 5): how many items may run at once per provider family x medium.
# Defaults: video 2, image 3, audio 2, text 3. A family can have its own ceiling,
# e.g. GENERATION_CONCURRENCY_VIDEO_MINIMAX_H3=1.
# GENERATION_CONCURRENCY_VIDEO=2
# GENERATION_CONCURRENCY_IMAGE=3
# GENERATION_CONCURRENCY_AUDIO=2

# Several keys for one provider rotate per job-type bucket; a refused key cools down.
# CREDENTIAL_COOLDOWN_SECONDS=300
# Total wall-clock limit of one text-model call (default 1800 s = 30 min; reasoning models think long).
# LLM_CALL_DEADLINE_SECONDS=1800
# Longest silence between two reads of one text-model call (default 600 s; some providers send nothing while reasoning).
# LLM_READ_TIMEOUT_SECONDS=600
# Time allowed to open the connection; an unreachable host still fails fast.
# LLM_CONNECT_TIMEOUT_SECONDS=30
# Output budget of the consistency self-check that runs after every stage.
# QC_MAX_TOKENS=2500
# Self-hosted ComfyUI: nothing is sent until a workflow (API format) and its bindings are set.
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=/absolute/path/to/workflow_api.json
# COMFYUI_BINDINGS={"prompt":"6.inputs.text","image":"10.inputs.image","seed":"3.inputs.seed"}
# COMFYUI_API_KEY=

# A local proxy in fake-IP mode (Clash / Surge / sing-box) resolves every host into 198.18.0.0/15.
# Development accepts that pool as public; a production server opts in explicitly.
# ALLOW_PROXY_FAKE_IP=1
# PROXY_FAKE_IP_CIDR=198.18.0.0/15

# Episodes the structured writer plans side by side, with as many prose / visual calls beside them (1 = strictly serial).
# SCREENWRITING_EPISODE_CONCURRENCY=3
# Output-token limits (default 1M); a provider that takes less is retried at its own ceiling automatically.
# LLM_MAX_TOKENS=1000000
# SCREENWRITING_MAX_TOKENS=1000000
# SCREENWRITING_MAX_TOKENS_CAP=1000000
# Tell each episode's prose only after the previous episode's prose is finished (default: side by side, from the previous plan).
# SCREENWRITING_PROSE_CHAIN=0
# How much of a long source the overview / asset-inventory calls read (opening, spaced excerpts, ending); planning reads it all.
# SCREENWRITING_ANALYSIS_CHARS=48000
# Share of an outline-written episode's shots that must carry speech (dialogue, or narration in narration mode); 0 disables.
# SCREENWRITING_MIN_SPOKEN_SHOT_RATIO=0.7

# Market: an official market source preset with the release (disable-able, not deletable), and a proxy prefix for GitHub raw files.
# MARKET_OFFICIAL_SOURCE_URL=https://github.com/owner/market-repo
# MARKET_RAW_PROXY_PREFIX=
