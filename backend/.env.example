# AI short-drama server configuration. Never commit real secrets.

# Seedance / Volcengine Ark
SEEDANCE_API_KEY=YOUR_SEEDANCE_API_KEY
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_NAME=YOUR_SEEDANCE_VIDEO_MODEL
SEEDANCE_IMAGE_MODEL_NAME=YOUR_SEEDREAM_IMAGE_MODEL
SEEDANCE_IMAGE_SIZE=1440x2560
CHARACTER_SHEET_SIZE=2560x1440
SEEDANCE_PROMPT_OPT=1

# Text and image providers
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-turbo
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL_NAME=YOUR_GEMINI_MODEL
AGNES_API_KEY=YOUR_AGNES_API_KEY
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_NAME=agnes-2.0-flash

# MiniMax H3 video generation (server only)
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY
MINIMAX_H3_ENDPOINT=https://api.minimaxi.com/v2/video_generation
# Defaults to the official async query and file-retrieve endpoints on the same API host.
# MINIMAX_H3_STATUS_URL_TEMPLATE=https://api.minimaxi.com/v1/query/video_generation?task_id={task_id}
# MINIMAX_FILES_URL=https://api.minimaxi.com/v1/files/retrieve

# ElevenLabs TTS, dialogue, SFX, music, STT and dubbing (server only)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_FEMALE_ID=YOUR_ELEVENLABS_FEMALE_VOICE_ID
ELEVENLABS_VOICE_MALE_ID=YOUR_ELEVENLABS_MALE_VOICE_ID
# Optional stable per-character casting, JSON object: {"角色名":"voice_id"}
ELEVENLABS_VOICE_MAP={}

# Local Seedance 2.5 prompt optimizer; defaults to ~/Desktop/sd25-pe
# SD25_PE_SKILL_PATH=/absolute/path/to/sd25-pe

# Optional network proxy
# SEEDANCE_PROXY=http://127.0.0.1:7890

# Alibaba Cloud SMS
ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ALIBABA_CLOUD_ACCESS_KEY_ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ALIBABA_CLOUD_ACCESS_KEY_SECRET
ALIBABA_CLOUD_SMS_SIGN_NAME=YOUR_SMS_SIGN_NAME
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=YOUR_SMS_TEMPLATE_CODE

# Authentication. AUTH_SIGNING_SECRET must be random and at least 32 characters.
AUTH_SIGNING_SECRET=YOUR_RANDOM_32_PLUS_CHARACTER_SESSION_SECRET
AUTH_SESSION_TTL_SECONDS=86400
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_COOLDOWN_SECONDS=60
COOKIE_SECURE=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development only. Never enable either flag in production.
AUTH_MOCK_CODES=0
AUTH_EXPOSE_MOCK_CODE=0

# PostgreSQL product platform (users, capabilities, elements, membership, billing).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/short-drama
# Encrypts provider API keys saved through the global model configuration center.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production requires this value from a deployment secret manager. Development creates
# a gitignored mode-0600 backend/runtime/model-config.key when it is omitted.
# MODEL_CONFIG_MASTER_KEY=YOUR_FERNET_MASTER_KEY
# Local development administrator. These public defaults are rejected in production.
BOOTSTRAP_ADMIN=1
BOOTSTRAP_ADMIN_LOGIN=admin@short-drama
BOOTSTRAP_ADMIN_PASSWORD=admin@123

# HMAC secret for idempotent WeChat/Alipay webhook envelopes (32+ characters).
PAYMENT_WEBHOOK_SECRET=YOUR_RANDOM_32_PLUS_CHARACTER_WEBHOOK_SECRET

# Optional local persistence paths (production should use an external durable store).
# USERS_DB_PATH=/absolute/path/to/users_db.json
# TASKS_DB_PATH=/absolute/path/to/tasks_db.json
# STUDIO_DB_PATH=/absolute/path/to/studio.sqlite3
